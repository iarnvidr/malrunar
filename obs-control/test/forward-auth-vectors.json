{
  "comment": "Shared test vectors for forward_auth.py and forward-auth.mjs. Edit here, run scripts/sync-identity.sh. A case: config = environment (names carry the prefix), secret_file_contents = written to a temp file whose path becomes <prefix>PROXY_SECRET_FILE, request = {peer, headers}, expected = the Identity. expand = {PLACEHOLDER: n}: a string equal to PLACEHOLDER in the request headers or in expected is replaced by n letters a.",
  "prefix": "MALRUNAR_TEST_",
  "cases": [
    {"name": "nothing configured: anonymous even with headers",
     "config": {},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Groups": "admins"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "proxy address trusted: identity read, default header names",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Name": "Ada L", "Remote-Email": "ada@example.invalid", "Remote-Groups": "admins,dev"}},
     "expected": {"user": "ada", "name": "Ada L", "email": "ada@example.invalid", "groups": ["admins", "dev"], "trusted": true}},
    {"name": "untrusted address: headers ignored",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "198.51.100.7", "headers": {"Remote-User": "mallory", "Remote-Groups": "admins"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "missing peer address: headers ignored",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": null, "headers": {"Remote-User": "mallory"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "invalid peer address: headers ignored",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "not-an-address", "headers": {"Remote-User": "mallory"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "CIDR v4: first and last address match, neighbours do not",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.64/26"},
     "request": {"peer": "192.0.2.127", "headers": {"Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "CIDR v4: just outside",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.64/26"},
     "request": {"peer": "192.0.2.128", "headers": {"Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "CIDR v6 match among several networks",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.1, 2001:db8:abcd::/48"},
     "request": {"peer": "2001:db8:abcd:12::5", "headers": {"Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "CIDR v6 outside",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "2001:db8:abcd::/48"},
     "request": {"peer": "2001:db8:abce::5", "headers": {"Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "IPv6 network does not match an IPv4 peer",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "::/0"},
     "request": {"peer": "192.0.2.1", "headers": {"Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "IPv4-mapped IPv6 peer is matched as IPv4",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "::ffff:192.0.2.9", "headers": {"Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "secret only: right secret",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "# current\nsecret-number-one-0123\n",
     "request": {"peer": "198.51.100.7", "headers": {"X-Proxy-Secret": "secret-number-one-0123", "Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "secret only: wrong secret ignored",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "secret-number-one-0124", "Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "secret only: missing secret ignored",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "secret only: empty secret header ignored",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "", "Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "rotation: old secret accepted",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "# new first\n\nsecret-new-9876543210\nsecret-old-0123456789\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "secret-old-0123456789", "Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "rotation: new secret accepted",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-new-9876543210\nsecret-old-0123456789\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "secret-new-9876543210", "Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "rotation: a third secret is rejected",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-new-9876543210\nsecret-old-0123456789\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "secret-third-5555555555", "Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "both required: address and secret pass",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "secret-number-one-0123", "Remote-User": "ada"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "both required: right secret from the wrong address",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "198.51.100.7", "headers": {"X-Proxy-Secret": "secret-number-one-0123", "Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "both required: right address without the secret",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "both required: right address with a wrong secret",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_PROXY_SECRET_HEADER": "X-Proxy-Secret"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-Proxy-Secret": "wrong-wrong-wrong-0000", "Remote-User": "ada"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": false}},
    {"name": "header-name overrides replace the defaults",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_USER_HEADER": "X-Auth-User", "MALRUNAR_TEST_GROUPS_HEADER": "X-Auth-Groups", "MALRUNAR_TEST_NAME_HEADER": "X-Auth-Name", "MALRUNAR_TEST_EMAIL_HEADER": "X-Auth-Email"},
     "request": {"peer": "192.0.2.10", "headers": {"X-Auth-User": "ada", "X-Auth-Groups": "dev", "X-Auth-Name": "Ada", "X-Auth-Email": "ada@example.invalid", "Remote-User": "mallory", "Remote-Groups": "admins"}},
     "expected": {"user": "ada", "name": "Ada", "email": "ada@example.invalid", "groups": ["dev"], "trusted": true}},
    {"name": "older IDENTITY_HEADER setting is the user header",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_IDENTITY_HEADER": "X-Forwarded-User"},
     "request": {"peer": "192.0.2.10", "headers": {"X-Forwarded-User": "ada", "Remote-User": "mallory"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "USER_HEADER wins over IDENTITY_HEADER",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24", "MALRUNAR_TEST_IDENTITY_HEADER": "X-Old", "MALRUNAR_TEST_USER_HEADER": "X-New"},
     "request": {"peer": "192.0.2.10", "headers": {"X-Old": "old", "X-New": "new"}},
     "expected": {"user": "new", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "header names and the secret header are case-insensitive",
     "config": {"MALRUNAR_TEST_PROXY_SECRET_HEADER": "x-proxy-secret", "MALRUNAR_TEST_USER_HEADER": "X-AUTH-USER"},
     "secret_file_contents": "secret-number-one-0123\n",
     "request": {"peer": "192.0.2.10", "headers": {"X-PROXY-SECRET": "secret-number-one-0123", "x-auth-user": "ada", "REMOTE-GROUPS": "dev"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": ["dev"], "trusted": true}},
    {"name": "groups: split, strip, drop empties, dedupe in order",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Groups": " admins , dev,,admins,  ops ,dev "}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": ["admins", "dev", "ops"], "trusted": true}},
    {"name": "groups: empty value gives no groups",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Groups": " , "}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "values are stripped",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "  ada  ", "Remote-Name": " Ada L "}},
     "expected": {"user": "ada", "name": "Ada L", "email": null, "groups": [], "trusted": true}},
    {"name": "control characters: newline in the user rejects it",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada\nadmin", "Remote-Name": "Ada"}},
     "expected": {"user": null, "name": "Ada", "email": null, "groups": [], "trusted": true}},
    {"name": "control characters: NUL and carriage return in name and email rejected",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Name": "Ada\u0000", "Remote-Email": "a\r@example.invalid"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "control characters: a group with one rejects the whole groups header",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Groups": "dev,adm\tins"}},
     "expected": {"user": "ada", "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "control characters: DEL rejected",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ad\u007fa"}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": true}},
    {"name": "too long: a 257 character user is rejected, 256 accepted",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "u", "Remote-Name": "NAME_257", "Remote-Email": "EMAIL_256"}},
     "expected": {"user": "u", "name": null, "email": "EMAIL_256", "groups": [], "trusted": true},
     "expand": {"NAME_257": 257, "EMAIL_256": 256}},
    {"name": "non-ASCII names are kept",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {"Remote-User": "ada", "Remote-Name": "Ada Løvelace"}},
     "expected": {"user": "ada", "name": "Ada Løvelace", "email": null, "groups": [], "trusted": true}},
    {"name": "trusted request without a user header is trusted but anonymous",
     "config": {"MALRUNAR_TEST_TRUSTED_PROXIES": "192.0.2.0/24"},
     "request": {"peer": "192.0.2.10", "headers": {}},
     "expected": {"user": null, "name": null, "email": null, "groups": [], "trusted": true}}
  ]
}
