# Example only. Install as ~/.config/systemd/user/malrunar-media-bridge.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now malrunar-media-bridge
# Settings go in ~/.config/malrunar/media-bridge.env, one KEY=value per line, for example
#   MALRUNAR_BRIDGE_UDP_PORT=5004
#   MALRUNAR_BRIDGE_VIDEO_DEVICE=/dev/video10
[Unit]
Description=Media bridge: MPEG-TS over UDP to a virtual camera and microphone
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/malrunar/media-bridge.env
ExecStart=/opt/malrunar/media-bridge/bin/malrunar-media-bridge
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=default.target
