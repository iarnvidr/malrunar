VERSION=0.7.4
# thunderbird-mcp (https://github.com/TKasperczyk/thunderbird-mcp, MIT): the tag, and the commit it must
# resolve to (asserted by the build, so a moved tag fails instead of changing the image).
THUNDERBIRD_MCP_VERSION=0.7.4
THUNDERBIRD_MCP_COMMIT=e6e9014b2baefea68ab97db76586cf875aca77ba
# Inline-image limits compiled into the add-on, in bytes of BASE64 (a base64 string is 4/3 the size of the
# image). Upstream hardcodes 1 MiB per image and 4 MiB in total, which silently skips ordinary photos;
# these defaults are 96 MiB and 384 MiB (about 72 MiB and 288 MiB of actual image). Plain integers, a multiple
# of 1048576. Changing them changes the image (and the add-on's version: 0.7.4.<PATCH_SET*100000 + MiB*100 + MiB>).
MAX_INLINE_IMAGE_BASE64_BYTES=100663296
MAX_INLINE_IMAGES_TOTAL_BASE64_BYTES=402653184
# Bumped when build-xpi.py changes what it does to the source, so the add-on version moves with it.
PATCH_SET=1
# The image that only clones and packages (git, python3). Nothing from it ends up in the component, so these
# are pinned here and moved by hand, and the weekly update of the shared pins does not republish this image.
FETCH_IMAGE=ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
FETCH_APT_SNAPSHOT=20261021T233000Z
