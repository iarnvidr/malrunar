VERSION=158.0.1
# Thunderbird: the latest stable release at the time of writing (Mozilla's unaltered-distribution
# policy asks for the latest version, so scripts/bump_pins.py moves these two with the release).
# The sha256 is the one in the release's PGP-signed SHA256SUMS for
# linux-x86_64/en-US/thunderbird-<version>.tar.xz on archive.mozilla.org.
THUNDERBIRD_VERSION=158.0.1
THUNDERBIRD_SHA256=1dc49731b31cc1d820b4dcec678ce2b01aa26c226f6e7cca4ba4807289763ce0
# Primary key fingerprint of "Mozilla Software Releases": the build checks that SHA256SUMS.asc is
# signed by a subkey of it, using the key file committed next to the Dockerfile (mozilla-release-keys.asc,
# Mozilla's KEY file of the release directory).
MOZILLA_SIGNING_KEY_FINGERPRINT=14F26682D0916CDD81E37B6D61B7B526D98F0353
# The image that only verifies and unpacks the download (gnupg, xz-utils). Nothing from it ends up in
# the component, so these are pinned here and moved by hand: the weekly update of the shared pins does
# not republish thunderbird.
FETCH_IMAGE=ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
FETCH_APT_SNAPSHOT=20261021T233000Z
