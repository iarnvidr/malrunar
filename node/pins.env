# Image that only unpacks the tarball (tar). Nothing from it ends up in the component, so it is its own
# pin, moved by hand, and the weekly update of the root UBUNTU_IMAGE does not republish node.
FETCH_IMAGE=ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
