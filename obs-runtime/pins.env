# Human tag: the upstream OBS version. The Debian version below is not a valid OCI tag (it has a tilde).
VERSION=32.2.0
# OBS Studio from the OBS Project PPA (ppa:obsproject/obs-studio), pinned by the exact .deb sha256.
# The PPA keeps only the latest version, so a bump must be made promptly or from the mirrored assets
# (scripts/fetch-source.sh downloads and verifies the .deb plus its source package from these pins).
