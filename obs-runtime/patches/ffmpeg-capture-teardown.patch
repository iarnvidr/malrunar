--- a/plugins/obs-ffmpeg/obs-ffmpeg-output.c
+++ b/plugins/obs-ffmpeg/obs-ffmpeg-output.c
@@ -1104,9 +1104,30 @@
-static void ffmpeg_output_full_stop(void *data)
-{
-	struct ffmpeg_output *output = data;
-
-	if (output->active) {
-		obs_output_end_data_capture(output->output);
-		ffmpeg_deactivate(output);
-	}
-}
+static void ffmpeg_capture_deactivated(void *data, calldata_t *params)
+{
+	os_event_signal(data);
+	UNUSED_PARAMETER(params);
+}
+
+static void ffmpeg_output_full_stop(void *data)
+{
+	struct ffmpeg_output *output = data;
+
+	if (output->active) {
+		os_event_t *capture_ended;
+		if (os_event_init(&capture_ended, OS_EVENT_TYPE_MANUAL) != 0) {
+			blog(LOG_ERROR, "FFmpeg output: could not initialize capture teardown barrier");
+			return;
+		}
+
+		/* end_data_capture returns before its callback-disconnection thread
+		 * finishes. Never free AVCodecContexts while raw callbacks use them. */
+		signal_handler_t *signals = obs_output_get_signal_handler(output->output);
+		signal_handler_connect(signals, "deactivate", ffmpeg_capture_deactivated, capture_ended);
+		const bool capturing = obs_output_active(output->output);
+		obs_output_end_data_capture(output->output);
+		if (capturing)
+			os_event_wait(capture_ended);
+		signal_handler_disconnect(signals, "deactivate", ffmpeg_capture_deactivated, capture_ended);
+		os_event_destroy(capture_ended);
+		ffmpeg_deactivate(output);
+	}
+}
