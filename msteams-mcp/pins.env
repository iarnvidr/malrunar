# msteams-mcp component. Upstream and its browser are pinned here; the Ubuntu image, its apt snapshot and
# the Node.js release below only BUILD the package (nothing from them ends up in the component), so
# they are this image's own pins and are moved by hand: a weekly bump of the shared pins does not
# republish this image. VERSION is the upstream version that the pinned commit was published as.
VERSION=0.27.2
# https://github.com/m0nkmaster/msteams-mcp (MIT). The commit npm published as 0.27.2 (its gitHead);
# package.json at that commit still says 0.27.1, the version bump was made while publishing. Building
# the commit with the package-lock.json it contains gives a dist/ identical to the published tarball.
MSTEAMS_MCP_COMMIT=a69069cd3f4852122de2db0beb1a58c51876fccd
# Playwright's own patched Firefox build, the only Firefox that implements the protocol Playwright
# drives (juggler). The revision must be the one the locked Playwright (1.58.0) asks for; the build
# asserts it. SHA256 is that of firefox-ubuntu-24.04.zip on cdn.playwright.dev for this revision.
PLAYWRIGHT_FIREFOX_REVISION=1509
PLAYWRIGHT_FIREFOX_SHA256=8690bdaf3614f2b311dd711536675508d62a0ac4ce13dd380807494d1a13cf87
# Build-time only: image, apt snapshot (git, unzip) and the Node.js release that runs npm and tsc.
FETCH_IMAGE=ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
FETCH_APT_SNAPSHOT=20261021T233000Z
BUILD_NODE_VERSION=24.22.1
BUILD_NODE_SHA256=eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c
